# ─── Core ────────────────────────────────────────────────────────────────
# Postgres connection for the app. Use a dedicated NOSUPERUSER NOBYPASSRLS role
# so row-level security is enforced (see docs/SECURITY.md).
DATABASE_URL=postgres://sehat:sehat@localhost:5432/sehat
# Optional: separate (owner) connection used only by `npm run db:migrate`
# MIGRATION_DATABASE_URL=

# Public URL of the site (https in production — enables Secure/__Host- cookies, HSTS)
APP_URL=http://localhost:3000
APP_NAME=SehatLens

# 32-byte base64 master key for per-user encryption. Generate with:
#   openssl rand -base64 32
# KEEP IT SECRET and BACKED UP — losing it makes stored reports unreadable.
ENCRYPTION_KEY=
# During key rotation: put the old key here and the new one in ENCRYPTION_KEY.
# ENCRYPTION_KEY_PREVIOUS=

# Where encrypted report files are stored (mount persistent storage in production)
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=15
ALLOW_SIGNUPS=true
# Number of reverse proxies in front of the app (for client IP / rate limiting)
TRUSTED_PROXY_HOPS=1

# ─── Email (password reset) ──────────────────────────────────────────────
# e.g. smtp://user:pass@email-smtp.ap-south-1.amazonaws.com:587
SMTP_URL=
EMAIL_FROM="SehatLens <no-reply@example.in>"

# ─── OCR (scanned reports / photos are read locally, never sent out) ─────
OCR_ENABLED=true
# Tesseract languages, e.g. eng or eng+hin
TESSERACT_LANGS=eng

# ─── Free LLMs for extraction (all optional; tried in this order) ────────
LLM_PROVIDERS=groq,gemini,openrouter,ollama,custom
# Providers allowed to receive un-redacted text and images (self-hosted only!)
LLM_TRUSTED_PROVIDERS=ollama

# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio — free tier: https://aistudio.google.com/apikey
# (free-tier prompts may be used by Google to improve products; we only send redacted text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Self-hosted Ollama (fully private): https://ollama.com
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=
# Any other OpenAI-compatible endpoint (e.g. an India-hosted model)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_VISION_MODEL=

# ─── DPDP Act: Grievance Officer shown on the privacy notice ─────────────
GRIEVANCE_OFFICER_NAME="Grievance Officer"
GRIEVANCE_OFFICER_EMAIL=grievance@example.in
